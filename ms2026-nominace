<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tipovačka — MS v hokeji 2026</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #0d1117; --bg2: #161b22; --bg3: #21262d;
    --border: #30363d; --border2: #484f58;
    --text: #e6edf3; --text2: #8b949e; --text3: #484f58;
    --blue: #1f6feb; --blue-bg: #0d2035; --blue-txt: #58a6ff;
    --teal: #1f6344; --teal-bg: #0d2b1e; --teal-txt: #3fb950;
    --purple: #3d2674; --purple-bg: #1a1135; --purple-txt: #bc8cff;
    --amber: #7d4e00; --amber-bg: #2b1d00; --amber-txt: #e3b341;
    --red-bg: #2d1011; --red-txt: #f85149;
    --radius: 8px; --radius-lg: 12px;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --mono: 'SFMono-Regular', Consolas, monospace;
  }
  body { background: var(--bg); color: var(--text); font-family: var(--font); min-height: 100vh; }
  .app { max-width: 760px; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
  .hdr { text-align: center; margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border); }
  .hdr h1 { font-size: 20px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--text); }
  .hdr p { font-size: 12px; color: var(--text2); margin-top: 5px; }
  .hdr-badge { display: inline-block; margin-top: 8px; font-size: 11px; padding: 3px 10px; border-radius: 999px; background: var(--amber-bg); color: var(--amber-txt); border: 1px solid var(--amber); }

  .tabs { display: flex; gap: 0; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: 1.25rem; }
  .tab { flex: 1; padding: 9px 6px; font-size: 12px; text-align: center; cursor: pointer; background: transparent; border: none; color: var(--text2); border-right: 1px solid var(--border); font-family: var(--font); transition: background .15s; }
  .tab:last-child { border-right: none; }
  .tab.active { background: var(--bg3); color: var(--text); font-weight: 500; }
  .tab:hover:not(.active) { background: var(--bg2); }
  .panel { display: none; }
  .panel.active { display: block; }

  .cnt-row { display: flex; gap: 6px; justify-content: center; margin-bottom: 1.1rem; flex-wrap: wrap; }
  .cnt { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); padding: 5px 12px; font-size: 11px; color: var(--text2); }
  .cnt b { color: var(--text); font-weight: 600; }
  .cnt.full { border-color: var(--teal); color: var(--teal-txt); }
  .cnt.full b { color: var(--teal-txt); }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
  .span2 { grid-column: 1 / -1; }
  @media(max-width:520px) { .grid2, .grid3 { grid-template-columns: 1fr; } }

  .box { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 0; }
  .bh { padding: 9px 12px 8px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
  .bt { font-size: 12px; font-weight: 600; color: var(--text); text-transform: uppercase; letter-spacing: .08em; }
  .bb { font-size: 10px; padding: 2px 8px; border-radius: 999px; font-weight: 500; }
  .bb-g { background: var(--blue-bg); color: var(--blue-txt); border: 1px solid var(--blue); }
  .bb-d { background: var(--purple-bg); color: var(--purple-txt); border: 1px solid var(--purple); }
  .bb-f { background: var(--teal-bg); color: var(--teal-txt); border: 1px solid var(--teal); }

  .plist { padding: 6px; display: flex; flex-direction: column; gap: 2px; max-height: 230px; overflow-y: auto; }
  .plist-f { padding: 6px; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; max-height: 200px; overflow-y: auto; }
  .pi { display: flex; align-items: center; gap: 7px; padding: 6px 8px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; user-select: none; transition: background .1s; }
  .pi:hover { background: var(--bg3); }
  .pi.sel { background: var(--bg3); border-color: var(--border2); }
  .pi.dis { opacity: .3; cursor: not-allowed; }
  .dot { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--border2); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .pi.sel .dot { background: var(--teal); border-color: var(--teal); }
  .pi.sel.pg .dot { background: var(--blue); border-color: var(--blue); }
  .pi.sel.pd .dot { background: var(--purple); border-color: var(--purple); }
  .dot-i { width: 5px; height: 5px; border-radius: 50%; background: white; display: none; }
  .pi.sel .dot-i { display: block; }
  .pname { font-size: 12px; color: var(--text); flex: 1; }
  .pclub { font-size: 10px; color: var(--text3); }
  .nhl { font-size: 9px; padding: 1px 5px; border-radius: 999px; background: var(--amber-bg); color: var(--amber-txt); border: 1px solid var(--amber); font-weight: 600; flex-shrink: 0; }

  .addrow { padding: 7px; border-top: 1px solid var(--border); display: flex; gap: 5px; }
  .addrow input { flex: 1; font-size: 11px; padding: 5px 8px; border-radius: 6px; border: 1px solid var(--border2); background: var(--bg3); color: var(--text); outline: none; font-family: var(--font); }
  .addrow input:focus { border-color: var(--blue); }
  .addrow input::placeholder { color: var(--text3); }
  .addrow button { font-size: 11px; padding: 5px 9px; border-radius: 6px; border: 1px solid var(--border2); background: transparent; color: var(--text2); cursor: pointer; font-family: var(--font); white-space: nowrap; }
  .addrow button:hover { background: var(--bg3); }

  .squad-g { margin-bottom: 10px; }
  .sgl { font-size: 10px; color: var(--text2); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 5px; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; min-height: 24px; }
  .chip { font-size: 11px; padding: 3px 9px; border-radius: 999px; border: 1px solid transparent; }
  .cg { background: var(--blue-bg); color: var(--blue-txt); border-color: var(--blue); }
  .cd { background: var(--purple-bg); color: var(--purple-txt); border-color: var(--purple); }
  .cf { background: var(--teal-bg); color: var(--teal-txt); border-color: var(--teal); }
  .ce { background: var(--bg3); color: var(--text3); border-color: var(--border); font-style: italic; }

  .acts { display: flex; gap: 7px; justify-content: flex-end; padding: 10px 12px; border-top: 1px solid var(--border); flex-wrap: wrap; }
  .btn { font-size: 12px; padding: 6px 14px; border-radius: var(--radius); border: 1px solid var(--border2); background: transparent; color: var(--text2); cursor: pointer; font-family: var(--font); transition: background .1s; }
  .btn:hover { background: var(--bg3); }
  .btn-g { background: var(--teal); color: #fff; border-color: var(--teal); font-weight: 500; }
  .btn-g:hover { background: #155233; }
  .btn-g:disabled { opacity: .4; cursor: not-allowed; }
  .btn-b { background: var(--blue); color: #fff; border-color: var(--blue); font-weight: 500; }
  .btn-b:hover { background: #1558b8; }

  .info { padding: 10px 12px; font-size: 12px; color: var(--text2); line-height: 1.65; }
  .info b { color: var(--text); font-weight: 500; }

  .code-box { margin: 8px 12px; padding: 10px; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--radius); font-family: var(--mono); font-size: 11px; color: var(--amber-txt); word-break: break-all; max-height: 100px; overflow-y: auto; cursor: text; }
  .import-row { padding: 8px 12px; display: flex; gap: 7px; align-items: flex-start; flex-direction: column; }
  .import-row textarea { width: 100%; font-size: 11px; padding: 7px 9px; border-radius: var(--radius); border: 1px solid var(--border2); background: var(--bg3); color: var(--text); font-family: var(--mono); resize: vertical; min-height: 60px; outline: none; }
  .import-row textarea:focus { border-color: var(--blue); }
  .import-row .import-line { display: flex; gap: 7px; width: 100%; }

  .nick-row { padding: 9px 12px; border-bottom: 1px solid var(--border); display: flex; gap: 8px; align-items: center; }
  .nick-row label { font-size: 12px; color: var(--text2); white-space: nowrap; }
  .nick-row input { flex: 1; font-size: 12px; padding: 5px 9px; border-radius: var(--radius); border: 1px solid var(--border2); background: var(--bg3); color: var(--text); outline: none; font-family: var(--font); }
  .nick-row input:focus { border-color: var(--blue); }

  .lb-row { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-bottom: 1px solid var(--border); }
  .lb-row:last-child { border-bottom: none; }
  .lb-rank { font-size: 13px; font-weight: 600; color: var(--text3); width: 22px; text-align: center; flex-shrink: 0; }
  .lb-name { font-size: 13px; font-weight: 500; color: var(--text); flex: 1; }
  .lb-detail { font-size: 11px; color: var(--text2); }
  .lb-pts { font-size: 13px; font-weight: 600; color: var(--teal-txt); }
  .lb-empty { padding: 20px; text-align: center; font-size: 12px; color: var(--text2); }
  .lb-del { font-size: 10px; padding: 2px 6px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--text3); cursor: pointer; }
  .lb-del:hover { border-color: var(--red-txt); color: var(--red-txt); }

  .score-big { text-align: center; padding: 20px 12px 8px; }
  .score-num { font-size: 40px; font-weight: 700; color: var(--teal-txt); }
  .score-lbl { font-size: 12px; color: var(--text2); margin-top: 2px; }
  .score-bars { padding: 8px 12px 4px; display: flex; flex-direction: column; gap: 8px; }
  .sbar { display: flex; align-items: center; gap: 8px; }
  .sbar-label { font-size: 11px; color: var(--text2); width: 70px; text-align: right; }
  .sbar-track { flex: 1; height: 7px; background: var(--bg3); border-radius: 4px; overflow: hidden; }
  .sbar-fill { height: 100%; border-radius: 4px; background: var(--teal); transition: width .5s; }
  .sbar-val { font-size: 11px; font-weight: 500; color: var(--text); width: 55px; }

  .compare-chips { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px 12px 12px; }
  .c-hit { font-size: 11px; padding: 3px 8px; border-radius: 999px; background: var(--teal-bg); color: var(--teal-txt); border: 1px solid var(--teal); }
  .c-miss { font-size: 11px; padding: 3px 8px; border-radius: 999px; background: var(--red-bg); color: var(--red-txt); border: 1px solid #6e1a19; }

  .banner { margin: 0 12px 10px; padding: 8px 10px; border-radius: var(--radius); font-size: 12px; display: none; align-items: center; gap: 6px; }
  .banner.ok { background: var(--teal-bg); border: 1px solid var(--teal); color: var(--teal-txt); display: flex; }
  .banner.err { background: var(--red-bg); border: 1px solid #6e1a19; color: var(--red-txt); display: flex; }

  .off-mini { padding: 6px; display: flex; flex-direction: column; gap: 2px; max-height: 140px; overflow-y: auto; }
  .off-pi { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 6px; background: var(--bg3); }
  .off-pi span { font-size: 12px; flex: 1; }
  .off-del { font-size: 10px; padding: 1px 5px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--text3); cursor: pointer; }
  .off-del:hover { color: var(--red-txt); border-color: var(--red-txt); }

  .section-gap { margin-bottom: 10px; }
  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }
</style>
</head>
<body>
<div class="app">
  <div class="hdr">
    <h1>🏒 Tipovačka nominace</h1>
    <p>MS v hokeji 2026 · Švýcarsko · 15.–31. května · Trenér: Radim Rulík</p>
    <span class="hdr-badge">Otevři v libovolném prohlížeči — bez účtu</span>
  </div>

  <div class="tabs">
    <button class="tab active" onclick="showTab('pick')">Moje nominace</button>
    <button class="tab" onclick="showTab('liga')">Liga přátel</button>
    <button class="tab" onclick="showTab('eval')">Vyhodnotit</button>
  </div>

  <!-- TAB: PICK -->
  <div id="tab-pick" class="panel active">
    <div class="cnt-row">
      <div class="cnt" id="cnt-g"><b id="n-g">0</b>/3 brankáři</div>
      <div class="cnt" id="cnt-d"><b id="n-d">0</b>/8 obránci</div>
      <div class="cnt" id="cnt-f"><b id="n-f">0</b>/14 útočníci</div>
      <div class="cnt" id="cnt-t"><b id="n-t">0</b>/25 celkem</div>
    </div>
    <div class="grid2 section-gap">
      <div class="box">
        <div class="bh"><span class="bt">Brankáři</span><span class="bb bb-g">max 3</span></div>
        <div class="plist" id="list-g"></div>
        <div class="addrow"><input id="add-g" placeholder="Přidat brankáře..." onkeydown="if(event.key==='Enter')addC('g')"><button onclick="addC('g')">+ Přidat</button></div>
      </div>
      <div class="box">
        <div class="bh"><span class="bt">Obránci</span><span class="bb bb-d">max 8</span></div>
        <div class="plist" id="list-d"></div>
        <div class="addrow"><input id="add-d" placeholder="Přidat obránce..." onkeydown="if(event.key==='Enter')addC('d')"><button onclick="addC('d')">+ Přidat</button></div>
      </div>
      <div class="box span2">
        <div class="bh"><span class="bt">Útočníci</span><span class="bb bb-f">max 14</span></div>
        <div class="plist-f" id="list-f"></div>
        <div class="addrow"><input id="add-f" placeholder="Přidat útočníka..." onkeydown="if(event.key==='Enter')addC('f')"><button onclick="addC('f')">+ Přidat</button></div>
      </div>
    </div>
    <div class="box section-gap">
      <div class="bh"><span class="bt">Můj tip</span><span style="font-size:11px;color:var(--text2)" id="tip-count">0 z 25</span></div>
      <div style="padding:10px 12px">
        <div class="squad-g"><div class="sgl">Brankáři</div><div class="chips" id="chips-g"></div></div>
        <div class="squad-g"><div class="sgl">Obránci</div><div class="chips" id="chips-d"></div></div>
        <div class="squad-g"><div class="sgl">Útočníci</div><div class="chips" id="chips-f"></div></div>
      </div>
      <div class="acts">
        <button class="btn" onclick="resetAll()">Vymazat</button>
        <button class="btn btn-g" onclick="saveTip()">Uložit tip</button>
      </div>
      <div class="banner" id="pick-banner"></div>
    </div>
  </div>

  <!-- TAB: LIGA -->
  <div id="tab-liga" class="panel">
    <div class="box section-gap">
      <div class="bh"><span class="bt">Exportovat svůj tip</span></div>
      <div class="info">Zkopíruj kód níže a pošli ho kamarádům (WhatsApp, Discord, email...). Oni ho importují u sebe.</div>
      <div class="code-box" id="export-code">Nejprve sestav a ulož tip v záložce "Moje nominace".</div>
      <div class="acts">
        <button class="btn btn-b" onclick="copyCode()">Kopírovat kód</button>
      </div>
      <div class="banner" id="export-banner"></div>
    </div>

    <div class="box section-gap">
      <div class="bh"><span class="bt">Importovat tip kamaráda</span></div>
      <div class="info">Vlož kód od kamaráda a přidej ho do ligy:</div>
      <div class="import-row">
        <div class="import-line">
          <input type="text" id="import-nick" placeholder="Přezdívka kamaráda..." style="flex:1;font-size:12px;padding:5px 8px;border-radius:6px;border:1px solid var(--border2);background:var(--bg3);color:var(--text);outline:none;font-family:var(--font)">
        </div>
        <textarea id="import-code" placeholder="Vlož kód tipu zde..."></textarea>
        <div class="import-line">
          <button class="btn btn-g" onclick="importCode()" style="width:100%">Přidat do ligy</button>
        </div>
      </div>
      <div class="banner" id="import-banner"></div>
    </div>

    <div class="box">
      <div class="bh">
        <span class="bt">Liga přátel</span>
        <button class="btn" style="font-size:11px;padding:3px 8px" onclick="renderLeague()">Obnovit</button>
      </div>
      <div id="league-list"><div class="lb-empty">Zatím žádné tipy. Importuj tipy přátel výše.</div></div>
      <div class="info" id="liga-score-note" style="border-top:1px solid var(--border);padding:8px 12px">Pro zobrazení skóre zadej officiální nominaci v záložce Vyhodnotit.</div>
    </div>
  </div>

  <!-- TAB: EVAL -->
  <div id="tab-eval" class="panel">
    <div class="box section-gap">
      <div class="bh"><span class="bt">Výsledek mého tipu</span></div>
      <div id="my-score-area"><div class="lb-empty">Nejprve zadej officální nominaci níže.</div></div>
    </div>

    <div class="box">
      <div class="bh">
        <span class="bt">Officiální nominace</span>
        <span class="bb bb-g" id="off-cnt">0 / 25</span>
      </div>
      <div class="info">Po Rulíkově oznámení sem zadej skutečnou nominaci. Automaticky ohodnotí všechny tipy v lize.<br><b>Skóre:</b> 1 bod za každého správného hráče + bonus za celou pozici (+3 GK / +5 OBR / +7 ÚT).</div>
      <div class="grid3" style="padding:10px;gap:8px">
        <div>
          <div class="sgl" style="padding:0 2px 4px">Brankáři (3)</div>
          <div class="off-mini" id="off-list-g"></div>
          <div class="addrow" style="padding:5px 2px 0"><input id="off-add-g" placeholder="Brankář..." onkeydown="if(event.key==='Enter')addOff('g')"><button onclick="addOff('g')">+</button></div>
        </div>
        <div>
          <div class="sgl" style="padding:0 2px 4px">Obránci (8)</div>
          <div class="off-mini" id="off-list-d"></div>
          <div class="addrow" style="padding:5px 2px 0"><input id="off-add-d" placeholder="Obránce..." onkeydown="if(event.key==='Enter')addOff('d')"><button onclick="addOff('d')">+</button></div>
        </div>
        <div>
          <div class="sgl" style="padding:0 2px 4px">Útočníci (14)</div>
          <div class="off-mini" id="off-list-f"></div>
          <div class="addrow" style="padding:5px 2px 0"><input id="off-add-f" placeholder="Útočník..." onkeydown="if(event.key==='Enter')addOff('f')"><button onclick="addOff('f')">+</button></div>
        </div>
      </div>
      <div class="acts">
        <button class="btn" onclick="clearOff()">Vymazat</button>
        <button class="btn btn-g" onclick="saveOff()">Uložit & vyhodnotit</button>
      </div>
      <div class="banner" id="eval-banner"></div>
    </div>
  </div>
</div>

<script>
const PL = {
  g:[
    {n:"Daniel Vladař",c:"Calgary Flames",nhl:1},
    {n:"Karel Vejmelka",c:"Utah Hockey Club",nhl:1},
    {n:"Josef Kořenář",c:"HC Sparta Praha"},
    {n:"Lukáš Dostál",c:"Anaheim Ducks",nhl:1},
  ],
  d:[
    {n:"Filip Hronek",c:"Vancouver Canucks",nhl:1},
    {n:"Tomáš Kundrátek",c:"HC Třinec"},
    {n:"Jakub Krejčík",c:"HC Sparta Praha"},
    {n:"David Špaček",c:"Iowa Wild (AHL)"},
    {n:"Libor Hájek",c:"HC Dynamo Pardubice"},
    {n:"Daniel Gazda",c:"Ilves Tampere"},
    {n:"Jiří Ticháček",c:"Kärpät Oulu"},
    {n:"Filip Pyrochta",c:"BK Mladá Boleslav"},
    {n:"Radko Gudas",c:"Anaheim Ducks",nhl:1},
    {n:"Michal Kempný",c:"Brynäs IF"},
    {n:"Jan Rutta",c:"HC Servette Ženeva"},
    {n:"Radim Šimek",c:"HC Liberec"},
    {n:"Tomáš Galvas",c:"HC Dynamo Pardubice"},
  ],
  f:[
    {n:"David Pastrňák",c:"Boston Bruins",nhl:1},
    {n:"Martin Nečas",c:"Colorado Avalanche",nhl:1},
    {n:"Roman Červenka",c:"HC Dynamo Pardubice"},
    {n:"Tomáš Hertl",c:"Vegas Golden Knights",nhl:1},
    {n:"Pavel Zacha",c:"Boston Bruins",nhl:1},
    {n:"Lukáš Sedlák",c:"HC Dynamo Pardubice"},
    {n:"Ondřej Beránek",c:"HC Dynamo Pardubice"},
    {n:"Daniel Voženílek",c:"HC Dynamo Pardubice"},
    {n:"Jakub Flek",c:"HC Kometa Brno"},
    {n:"Matěj Stránský",c:"HC Sparta Praha"},
    {n:"Jakub Lauko",c:"HC Sparta Praha"},
    {n:"Filip Zadina",c:"HC Sparta Praha"},
    {n:"Jáchym Kondelík",c:"EHC Biel"},
    {n:"Adam Klapka",c:"HC Dynamo Pardubice"},
    {n:"Marek Alscher",c:"Bridgeport Islanders (AHL)"},
    {n:"Mikuláš Hovorka",c:"AHL"},
    {n:"Jiří Smejkal",c:"Rögle BK"},
    {n:"Adam Raška",c:"HC Sparta Praha"},
    {n:"Jan Drozg",c:"Örebro HK"},
  ]
};

const LIM = {g:3,d:8,f:14};
const S = {g:new Set,d:new Set,f:new Set};
const OFF = {g:new Set,d:new Set,f:new Set};

function LS(k,v){ if(v!==undefined){localStorage.setItem(k,JSON.stringify(v));}else{try{return JSON.parse(localStorage.getItem(k));}catch{return null;}} }

function total(){ return S.g.size+S.d.size+S.f.size; }

function renderList(pos){
  const isFwd = pos==='f';
  const el = document.getElementById('list-'+pos);
  el.className = isFwd ? 'plist-f' : 'plist';
  el.innerHTML='';
  PL[pos].forEach(p=>{
    const sel=S[pos].has(p.n);
    const full=S[pos].size>=LIM[pos]&&!sel;
    const d=document.createElement('div');
    d.className='pi p'+pos+(sel?' sel':'')+(full?' dis':'');
    d.innerHTML=`<div class="dot"><div class="dot-i"></div></div><span class="pname">${p.n}</span>${p.nhl?'<span class="nhl">NHL</span>':''}<span class="pclub">${p.c}</span>`;
    if(!full||sel) d.onclick=()=>toggle(pos,p.n);
    el.appendChild(d);
  });
}

function toggle(pos,name){
  S[pos].has(name)?S[pos].delete(name):(S[pos].size<LIM[pos]&&S[pos].add(name));
  renderAll();
}

function addC(pos){
  const inp=document.getElementById('add-'+pos);
  const n=inp.value.trim();
  if(!n) return;
  if(!PL[pos].find(p=>p.n===n)) PL[pos].push({n,c:'vlastní'});
  if(S[pos].size<LIM[pos]) S[pos].add(n);
  inp.value='';
  renderAll();
}

function renderChips(){
  ['g','d','f'].forEach(pos=>{
    const el=document.getElementById('chips-'+pos);
    el.innerHTML='';
    const arr=[...S[pos]];
    for(let i=0;i<LIM[pos];i++){
      const sp=document.createElement('span');
      sp.className=arr[i]?'chip c'+pos:'chip ce';
      sp.textContent=arr[i]||'—';
      el.appendChild(sp);
    }
  });
  document.getElementById('tip-count').textContent=total()+' z 25';
}

function renderCounters(){
  ['g','d','f'].forEach(pos=>{
    const n=S[pos].size,l=LIM[pos];
    document.getElementById('n-'+pos).textContent=n;
    document.getElementById('cnt-'+pos).className='cnt'+(n===l?' full':'');
  });
  const t=total();
  document.getElementById('n-t').textContent=t;
  document.getElementById('cnt-t').className='cnt'+(t===25?' full':'');
}

function renderAll(){
  ['g','d','f'].forEach(renderList);
  renderChips();
  renderCounters();
}

function saveTip(){
  const tip={g:[...S.g],d:[...S.d],f:[...S.f],at:new Date().toLocaleString('cs-CZ')};
  LS('ms2026-mytip',tip);
  showBanner('pick-banner','ok','Tip uložen!');
}

function resetAll(){ S.g.clear();S.d.clear();S.f.clear();renderAll(); }

function encodeTip(nick,tip){
  const obj={nick,g:tip.g,d:tip.d,f:tip.f,at:tip.at||new Date().toLocaleString('cs-CZ')};
  return btoa(unescape(encodeURIComponent(JSON.stringify(obj))));
}

function decodeTip(code){
  try{ return JSON.parse(decodeURIComponent(escape(atob(code)))); }catch{ return null; }
}

function copyCode(){
  const tip=LS('ms2026-mytip');
  if(!tip||(!tip.g.length&&!tip.d.length&&!tip.f.length)){
    showBanner('export-banner','err','Nejprve sestav a ulož tip!');return;
  }
  const nick=prompt('Tvoje přezdívka pro kód:','') || 'Anonym';
  const code=encodeTip(nick,tip);
  document.getElementById('export-code').textContent=code;
  navigator.clipboard.writeText(code).then(()=>showBanner('export-banner','ok','Kód zkopírován! Pošli ho kamarádům.'))
    .catch(()=>{ document.querySelector('.code-box').select?.(); showBanner('export-banner','ok','Kód vygenerován — označ a zkopíruj ho.'); });
}

function importCode(){
  const codeRaw=document.getElementById('import-code').value.trim();
  const nickOverride=document.getElementById('import-nick').value.trim();
  if(!codeRaw){ showBanner('import-banner','err','Vlož kód tipu.');return; }
  const tip=decodeTip(codeRaw);
  if(!tip||!tip.g||!tip.d||!tip.f){ showBanner('import-banner','err','Neplatný kód.');return; }
  if(nickOverride) tip.nick=nickOverride;
  const league=LS('ms2026-league')||[];
  const idx=league.findIndex(t=>t.nick===tip.nick);
  if(idx>=0) league[idx]=tip; else league.push(tip);
  LS('ms2026-league',league);
  document.getElementById('import-code').value='';
  document.getElementById('import-nick').value='';
  showBanner('import-banner','ok',`Tip od "${tip.nick}" přidán do ligy!`);
  renderLeague();
}

function calcScore(tip){
  const off={g:new Set(OFF.g),d:new Set(OFF.d),f:new Set(OFF.f)};
  if(!off.g.size&&!off.d.size&&!off.f.size){ const o=LS('ms2026-official'); if(o){['g','d','f'].forEach(p=>o[p].forEach(n=>off[p].add(n)));} }
  if(!off.g.size&&!off.d.size&&!off.f.size) return null;
  let pts=0;
  const bg=tip.g.filter(n=>off.g.has(n)).length;
  const bd=tip.d.filter(n=>off.d.has(n)).length;
  const bf=tip.f.filter(n=>off.f.has(n)).length;
  pts=bg+bd+bf;
  if(bg===3)pts+=3;
  if(bd===8)pts+=5;
  if(bf===14)pts+=7;
  return{pts,bg,bd,bf};
}

function renderLeague(){
  const league=LS('ms2026-league')||[];
  const el=document.getElementById('league-list');
  if(!league.length){ el.innerHTML='<div class="lb-empty">Žádné tipy. Importuj tipy přátel výše.</div>';return; }
  const hasOff=OFF.g.size||OFF.d.size||OFF.f.size||(()=>{const o=LS('ms2026-official');return o&&(o.g.length+o.d.length+o.f.length)>0;})();
  const scored=league.map(t=>({...t,score:calcScore(t)}));
  if(hasOff) scored.sort((a,b)=>(b.score?.pts||0)-(a.score?.pts||0));
  el.innerHTML='';
  scored.forEach((t,i)=>{
    const sc=t.score;
    const medal=hasOff&&sc?(i===0?'🥇 ':i===1?'🥈 ':i===2?'🥉 ':''):'';
    const row=document.createElement('div');
    row.className='lb-row';
    row.innerHTML=`<div class="lb-rank">${hasOff&&sc?i+1:'·'}</div>`+
      `<div style="flex:1"><div class="lb-name">${medal}${t.nick||'Anonym'}</div>`+
      `<div class="lb-detail">${t.g.length}G · ${t.d.length}OBR · ${t.f.length}ÚT${t.at?' · '+t.at:''}</div></div>`+
      (sc&&hasOff?`<div class="lb-pts">${sc.pts} b</div>`:
        `<div style="font-size:11px;color:var(--text2)">${(t.g.length+t.d.length+t.f.length)}/25</div>`)+
      `<button class="lb-del" onclick="delLeague(${i},event)">✕</button>`;
    el.appendChild(row);
  });
  document.getElementById('liga-score-note').textContent=
    hasOff?'Skóre: 1 bod/hráč + bonus (+3 GK, +5 OBR, +7 ÚT) za kompletně trefení pozici.':
    'Pro zobrazení skóre zadej officiální nominaci v záložce Vyhodnotit.';
}

function delLeague(idx,e){
  e.stopPropagation();
  const league=LS('ms2026-league')||[];
  league.splice(idx,1);
  LS('ms2026-league',league);
  renderLeague();
}

// OFFICIAL
function renderOffLists(){
  ['g','d','f'].forEach(pos=>{
    const el=document.getElementById('off-list-'+pos);
    el.innerHTML='';
    OFF[pos].forEach(n=>{
      const d=document.createElement('div');
      d.className='off-pi';
      d.innerHTML=`<span>${n}</span><button class="off-del" onclick="delOff('${pos}','${n}')">✕</button>`;
      el.appendChild(d);
    });
  });
  document.getElementById('off-cnt').textContent=(OFF.g.size+OFF.d.size+OFF.f.size)+' / 25';
}

function addOff(pos){
  const inp=document.getElementById('off-add-'+pos);
  const n=inp.value.trim();
  if(!n) return;
  if(OFF[pos].size<LIM[pos]) OFF[pos].add(n);
  inp.value='';
  renderOffLists();
}

function delOff(pos,n){ OFF[pos].delete(n); renderOffLists(); }

function clearOff(){ OFF.g.clear();OFF.d.clear();OFF.f.clear();renderOffLists(); }

function saveOff(){
  const data={g:[...OFF.g],d:[...OFF.d],f:[...OFF.f],at:new Date().toLocaleString('cs-CZ')};
  LS('ms2026-official',data);
  showBanner('eval-banner','ok','Officiální nominace uložena. Liga ohodnocena!');
  renderMyScore();
  renderLeague();
}

function renderMyScore(){
  const offData=LS('ms2026-official');
  if(OFF.g.size||OFF.d.size||OFF.f.size){/* use in-memory */}
  else if(offData){ ['g','d','f'].forEach(pos=>(offData[pos]||[]).forEach(n=>OFF[pos].add(n))); renderOffLists(); }

  const el=document.getElementById('my-score-area');
  const hasOff=OFF.g.size+OFF.d.size+OFF.f.size>0;
  if(!hasOff){ el.innerHTML='<div class="lb-empty">Nejprve zadej officiální nominaci níže.</div>';return; }
  if(!total()){ el.innerHTML='<div class="lb-empty">Nejprve sestav svůj tip v záložce Moje nominace.</div>';return; }

  const myTip={g:[...S.g],d:[...S.d],f:[...S.f]};
  const sc=calcScore(myTip);
  if(!sc){ el.innerHTML='<div class="lb-empty">Nejprve zadej officiální nominaci.</div>';return; }

  const allHitters=[...S.g,...S.d,...S.f];
  const allOff=new Set([...OFF.g,...OFF.d,...OFF.f]);

  el.innerHTML=`<div class="score-big"><div class="score-num">${sc.pts}</div><div class="score-lbl">bodů z max. 40</div></div>
  <div class="score-bars">
    <div class="sbar"><div class="sbar-label">Brankáři</div><div class="sbar-track"><div class="sbar-fill" style="width:${sc.bg/3*100}%"></div></div><div class="sbar-val">${sc.bg}/3${sc.bg===3?' <span style="color:var(--teal-txt)">+3</span>':''}</div></div>
    <div class="sbar"><div class="sbar-label">Obránci</div><div class="sbar-track"><div class="sbar-fill" style="width:${sc.bd/8*100}%"></div></div><div class="sbar-val">${sc.bd}/8${sc.bd===8?' <span style="color:var(--teal-txt)">+5</span>':''}</div></div>
    <div class="sbar"><div class="sbar-label">Útočníci</div><div class="sbar-track"><div class="sbar-fill" style="width:${sc.bf/14*100}%"></div></div><div class="sbar-val">${sc.bf}/14${sc.bf===14?' <span style="color:var(--teal-txt)">+7</span>':''}</div></div>
  </div>
  <div class="sgl" style="padding:8px 12px 4px">Trefení hráči:</div>
  <div class="compare-chips">${allHitters.map(n=>`<span class="${allOff.has(n)?'c-hit':'c-miss'}">${n}</span>`).join('')}</div>`;
}

function showBanner(id,type,msg){
  const b=document.getElementById(id);
  b.className='banner '+(type==='ok'?'ok':'err');
  b.textContent=msg;
  setTimeout(()=>b.className='banner',3500);
}

function showTab(t){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));
  document.getElementById('tab-'+t).classList.add('active');
  const tabs=['pick','liga','eval'];
  document.querySelectorAll('.tab')[tabs.indexOf(t)].classList.add('active');
  if(t==='liga'){ buildExportCode(); renderLeague(); }
  if(t==='eval'){ renderMyScore(); }
}

function buildExportCode(){
  const tip=LS('ms2026-mytip');
  if(!tip||(!tip.g.length&&!tip.d.length&&!tip.f.length)){
    document.getElementById('export-code').textContent='Nejprve sestav a ulož tip v záložce "Moje nominace".';
    return;
  }
  const nick = prompt && false ? '' : (LS('ms2026-nick')||'');
  const code=encodeTip(nick||'Můj tip', tip);
  document.getElementById('export-code').textContent=code;
}

function init(){
  const saved=LS('ms2026-mytip');
  if(saved){
    ['g','d','f'].forEach(pos=>{
      (saved[pos]||[]).forEach(n=>{
        if(!PL[pos].find(p=>p.n===n)) PL[pos].push({n,c:'vlastní'});
        S[pos].add(n);
      });
    });
  }
  const offSaved=LS('ms2026-official');
  if(offSaved){
    ['g','d','f'].forEach(pos=>(offSaved[pos]||[]).forEach(n=>OFF[pos].add(n)));
  }
  renderAll();
  renderOffLists();
}

init();
</script>
</body>
</html>
